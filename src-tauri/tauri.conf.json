{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Hanami Companion",
    "version": "0.1.0",
    "identifier": "website.hanami.companion",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "enableGTKAppId": true,
        "windows": [
            {
                "title": "Hanami Companion",
                "width": 400,
                "height": 550,
                "resizable": false,
                "maximizable": false,
                "decorations": true
            }
        ],
        "trayIcon": {
            "iconPath": "icons/icon.ico",
            "tooltip": "Hanami Companion"
        },
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
    }
}
