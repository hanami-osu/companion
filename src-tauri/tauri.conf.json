{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Hanami Companion",
    "version": "0.1.0",
    "identifier": "com.yorunoken.hanami.companion",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist"
    },
    "app": {
        "enableGTKAppId": true,
        "windows": [
            {
                "title": "Hanami Companion",
                "width": 440,
                "height": 700,
                "minWidth": 420,
                "minHeight": 580,
                "resizable": true,
                "maximizable": false,
                "decorations": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
    }
}
